{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Merlin-RustDesk",
  "version": "0.1.0",
  "identifier": "eu.raapp.merlinremote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "dmg",
      "app"
    ],
    "publisher": "Merlin",
    "linux": {
      "deb": {
        "depends": [
          "libxdo3",
          "libayatana-appindicator3-1"
        ]
      },
      "appimage": {
        "files": {
          "/usr/lib/libxdo.so.3": "/usr/lib/x86_64-linux-gnu/libxdo.so.3"
        }
      }
    }
  }
}